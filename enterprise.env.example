# Secrets belong in the host's secret manager. Never commit a populated copy.
LOAMY_WORKSPACE_WEB_ORIGIN=https://business.example.com
LOAMY_WORKSPACE_API_ORIGIN=https://business.example.com
# Dedicated private-schema application role; never use postgres or a service-role browser key.
# URL-encode passwords. Mount the database CA certificate if required by the provider.
LOAMY_WORKSPACE_DATABASE_URL=postgresql://loamy_enterprise_app:REPLACE@DATABASE_HOST:5432/DATABASE?sslmode=verify-full&sslrootcert=/run/secrets/database-ca.crt
LOAMY_MAIL_TRANSPORT=smtp
LOAMY_SMTP_HOST=REPLACE
LOAMY_SMTP_PORT=587
LOAMY_SMTP_SECURITY=starttls
LOAMY_SMTP_FROM=REPLACE
LOAMY_SMTP_USERNAME=REPLACE
LOAMY_SMTP_PASSWORD=REPLACE
LOAMY_WORKSPACE_SERVE_DIST=1
# Set FORWARDED_ALLOW_IPS to the actual reverse proxy IP/network at deployment.
# Never trust arbitrary clients' X-Forwarded-* headers; do not set it to *.
FORWARDED_ALLOW_IPS=127.0.0.1
# Optional inbound WhatsApp integration. Leave ALL unset to keep live intake disabled.
# Configure these only in the secret manager after operator ownership checks.
# LOAMY_WHATSAPP_APP_SECRET=<Meta app secret, at least 24 characters>
# LOAMY_WHATSAPP_VERIFY_TOKEN=<random private handshake token, at least 24 characters>
# LOAMY_WHATSAPP_ACCESS_TOKEN=<authorized system-user token for receipt retrieval>
# LOAMY_WHATSAPP_GRAPH_VERSION=<supported version confirmed in the Meta app, e.g. vNN.0>
# LOAMY_WHATSAPP_ROUTES={"<approved-phone-number-id>":"<existing-business-id>"}
# Optional outbound invoices/reminders. Requires the existing approved route and secrets above.
# Configure approved DOCUMENT-header templates with six body parameters; see handoff section 17.
# LOAMY_WHATSAPP_OUTBOUND={"<existing-business-id>":{"phone_id":"<approved-phone-number-id>","invoice_template":"<approved-template>","reminder_template":"<approved-template>","language":"en"}}
