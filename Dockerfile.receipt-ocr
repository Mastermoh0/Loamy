FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr-eng poppler-utils && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home reader
RUN apt-get update && apt-get install -y --no-install-recommends python3 tesseract-ocr && rm -rf /var/lib/apt/lists/*
COPY workspace_receipt_reader.py /app/workspace_receipt_reader.py
USER reader
WORKDIR /tmp
CMD ["tesseract", "--version"]
